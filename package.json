{
  "name": "kazuvin-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.20.0",
    "pnpm": ">=11.25.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:up": "sh scripts/dev.sh up",
    "dev:down": "sh scripts/dev.sh down",
    "build": "next build",
    "preview": "pnpm run build && wrangler dev",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "deploy": "pnpm run build && wrangler deploy",
    "ci:check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@fontsource-variable/noto-sans-mono": "^5.3.0",
    "@mdx-js/mdx": "^3.1.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@shikijs/rehype": "^4.4.3",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "gray-matter": "^4.0.3",
    "next": "^16.3.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@chromatic-com/storybook": "^4.1.2",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.0",
    "@types/hast": "^3.0.5",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "^4.1.11",
    "agentation": "^3.0.2",
    "agentation-mcp": "^1.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "happy-dom": "^20.0.10",
    "knip": "^6.33.0",
    "lefthook": "^2.1.12",
    "playwright": "^1.56.1",
    "storybook": "^10.6.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.45.3"
  }
}
