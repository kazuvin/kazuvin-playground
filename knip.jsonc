{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // App Router の規約ファイルがエントリ。ここから辿れないファイルは使われていない。
  // src/app/ 配下はファイルの存在そのものが URL になるので、すべてエントリ扱いにする。
  // next.config.ts / .storybook は Next・Storybook のプラグインが自動で拾うため、
  // ここに書かない。
  "entry": ["src/app/**/*.{ts,tsx}"],
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreDependencies": [
    // globals.css の `@import "tailwindcss"` から使う。
    // knip は CSS の import を辿らないので検出できない。
    "tailwindcss",
    // .mcp.json と scripts/dev.sh から実体 (node_modules/.bin) を叩く。
    // どちらも JS ではないので knip の対象外。
    "agentation-mcp"
  ]
}
