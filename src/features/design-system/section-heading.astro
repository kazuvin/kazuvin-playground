---
import { Text } from '@/components/ui/text'
import { findCatalogSection } from './catalog'

/*
 * カタログの見出し。文言と段は catalog.ts が持ち、ページは id しか書かない。
 * 目次に無い id を書くと findCatalogSection がビルドを落とすので、右レールの
 * リンクとページのアンカーがずれたまま配信されることがない。
 *
 * scroll-mt は .note-content の見出しと同じ値。lg 未満では左ナビが横バーとして
 * 上に被るので、そのぶん多めに逃がす。
 */
interface Props {
  id: string
}

const { id } = Astro.props
const section = findCatalogSection(id)
const isSection = section.depth === 2
---

<Text
  role={isSection ? 'heading' : 'subheading'}
  as={isSection ? 'h2' : 'h3'}
  id={section.id}
  className="scroll-mt-24 lg:scroll-mt-8"
>
  {section.title}
</Text>
