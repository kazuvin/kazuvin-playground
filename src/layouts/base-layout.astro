---
/* Kotoba loads three families, self-hosted. The two Latin ones go through
   Astro の Fonts API (<Font> = @font-face + preload + メトリクス補正済みの
   代替 face)、CJK の Noto Sans JP だけは @font-face が 124 本あって head に
   インライン展開すると HTML が 100KB 増えるので、従来どおり CSS を import
   して外部スタイルシートに残す。宣言は astro.config.mjs、family 名と
   トークンの対応は src/styles/globals.css。 */
import { Font } from 'astro:assets'
import '@fontsource-variable/noto-sans-jp'
import '@/styles/globals.css'
import { APP_DESCRIPTION, APP_NAME } from '@/config/app'

interface Props {
  /** ページ固有のタイトル。省略時はサイト名のみ */
  title?: string
  /** ページ固有の説明 */
  description?: string
}

const { title, description = APP_DESCRIPTION } = Astro.props
const pageTitle = title ? `${title} | ${APP_NAME}` : APP_NAME
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <Font cssVariable="--font-source-sans-3" preload />
    <Font cssVariable="--font-geist-mono" />
  </head>
  <body>
    <slot />
  </body>
</html>
