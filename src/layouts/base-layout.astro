---
/* Kotoba は 2 書体を self-host する。欧文の Noto Sans Mono は Astro の
   Fonts API (<Font> = @font-face + preload + メトリクス補正済みの代替 face)、
   CJK の Noto Sans JP だけは @font-face が 124 本あって head にインライン
   展開すると HTML が 100KB 増えるので、CSS を import して外部スタイルシート
   に残す。宣言は astro.config.mjs、family 名とトークンの対応は
   src/styles/globals.css。 */
import { Font } from 'astro:assets'
import '@fontsource-variable/noto-sans-jp'
import '@/styles/globals.css'
import { APP_DESCRIPTION, APP_NAME } from '@/config/app'

interface Props {
  /** ページ固有のタイトル。省略時はサイト名のみ */
  title?: string
  /** ページ固有の説明 */
  description?: string
}

const { title, description = APP_DESCRIPTION } = Astro.props
const pageTitle = title ? `${title} | ${APP_NAME}` : APP_NAME
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <Font cssVariable="--font-noto-sans-mono" preload />
  </head>
  <body>
    <slot />
    {
      /* Agentation。画面の要素をクリックして指摘を書き残す開発用ツールバーで、
         クリックした要素のセレクタ・クラス名・位置を添えた markdown をエージェント
         に渡す。endpoint を与えた指摘は localStorage ではなく agentation-mcp の
         HTTP サーバに載り、MCP 経由で Claude Code が直接読む (.mcp.json 参照)。
         サーバが起きていなければツールバーは localStorage に落ちるだけなので、
         MCP を使わないときも dev は壊れない。

         island (client:only) ではなく素の script で載せている。island は
         テンプレート側を import.meta.env.DEV で切っても、ビルドがチャンクを
         必ず吐く: どこからも参照されない 412KB が dist に残り、そのまま
         Cloudflare に上がる。dynamic import を DEV の枝に入れれば、本番では
         Vite が DEV を false に畳んで枝ごと消えるのでチャンク自体が生まれない。 */
    }
    <script>
      if (import.meta.env.DEV) {
        const { mountAgentationToolbar } = await import('@/components/dev/agentation-toolbar')
        mountAgentationToolbar()
      }
    </script>
  </body>
</html>
