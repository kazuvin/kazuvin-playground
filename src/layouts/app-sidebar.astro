---
import { APP_NAME, NAV_ITEMS } from '@/config/app'
import { CommandSearch } from '@/features/notes/command-search'
import { cn } from '@/lib/cn'
import { isActiveNavItem } from '@/lib/nav'

/*
 * グローバルナビの左レール。ヘッダーは持たず、旧 app-header.astro が持っていた
 * サイト名・コマンドパレット・行き先の 3 つをすべてここが引き取る。
 *
 * 位置取りが 2 通りあるのは意図的。どちらも sticky で、違うのは幅と流れ方だけ。
 *   lg 以上: 本文の左隣に付く縦レール。common-layout の grid の 1 トラック目に
 *            乗り、self-start + h-dvh で上端に貼り付く。画面の左端ではなく
 *            <main> の隣に居る (端に逃がすと広い画面で本文から離れすぎる)。
 *            トラックは auto なので、幅を決めるのはここの中身 —— 実質は一番長い
 *            ナビラベル。ラベルを足したり伸ばしたりするとレールの幅も動く。
 *            折り返させない (whitespace-nowrap) のはそのため。
 *   lg 未満: 全幅の横バー。1 カラムに畳まれた grid の 1 行目で、通常フローに
 *            残るぶん <main> 側にバーの高さを px で焼き込まずに済む。
 */
const pathname = Astro.url.pathname
const navItems = NAV_ITEMS.map((item) => ({
  ...item,
  isActive: isActiveNavItem(pathname, item.href),
}))
---

<aside
  class="border-border-hairline bg-background/80 px-edge-h py-gap lg:pt-edge-top lg:pb-edge-bottom sticky top-0 z-20 self-start border-b text-base backdrop-blur-2xl lg:h-dvh lg:overflow-y-auto lg:border-b-0 lg:bg-transparent lg:backdrop-blur-none"
>
  <div
    class="gap-gap lg:gap-block-tight flex items-center justify-between lg:flex-col lg:items-start"
  >
    {
      /* サイト名の文字はロゴマークが引き取る。読み上げと検索に残る名前は alt が持つ。

         astro:assets ではなく public/ の素の <img>。<Image> の変換には sharp の
         実体が要る (依存に無い) が、この 1 枚は表示サイズが 32/40px に固定で、
         書き出し済みの 104x160 (3x 相当) から先の最適化で得るものが無い。
         width/height は原画の実寸で、比を先に伝えて読み込み時のずれを防ぐ。
         表示サイズは class 側が決める。レールの上端に出る唯一の画像なので
         loading は既定の eager のまま (lazy にすると初回に一瞬空く)。 */
    }
    <a href="/" class="ease-standard inline-flex transition-opacity duration-120 hover:opacity-70">
      <img src="/logo.png" alt={APP_NAME} width="104" height="160" class="h-8 w-auto lg:h-10" />
    </a>
    {/* サイト全体でこれだけが island。ほかは静的 HTML のまま配信される */}
    <CommandSearch client:idle />
  </div>

  <nav
    aria-label="Site"
    class="gap-block-tight mt-gap lg:mt-block lg:gap-gap-tight flex overflow-x-auto lg:flex-col lg:overflow-x-visible"
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          aria-current={item.isActive ? 'page' : undefined}
          class={cn(
            'py-gap-tight ease-standard whitespace-nowrap transition-colors duration-120',
            item.isActive
              ? 'text-foreground font-medium'
              : 'text-subtle-foreground hover:text-foreground',
          )}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</aside>
