---
import AppHeader from './app-header.astro'
import BaseLayout from './base-layout.astro'

interface Props {
  /** ページ固有のタイトル */
  title?: string
  /** ページ固有の説明 */
  description?: string
}

const { title, description } = Astro.props
---

<BaseLayout title={title} description={description}>
  <AppHeader class="sticky top-0 z-20 mx-16 px-4" />
  <main class="mx-auto grid w-full max-w-2xl grid-cols-1 gap-10 px-3 text-base md:pb-24">
    <slot />
  </main>
</BaseLayout>
