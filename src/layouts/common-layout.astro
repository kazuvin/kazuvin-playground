---
import type { MarkdownHeading } from 'astro'
import AppSidebar from './app-sidebar.astro'
import BaseLayout from './base-layout.astro'
import TocSidebar from './toc-sidebar.astro'

/*
 * 3 カラムの外枠。ヘッダーは持たない。
 *
 *   左 (auto)   グローバルナビ。全ページ共通で、行き先と検索を担う。
 *   中央 (624)  本文。読み幅 max-w-xl = 576 + 左右の 24 で 624。
 *   右 (240px)  ページ専用ナビ。今は記事の目次で、無いページでは描かれない。
 *
 * 3 つは 1 本の grid に入っていて、レールは画面の端ではなく本文の両脇に付く。
 * トラックはどれも画面幅では伸びない (中央は minmax(0, 39rem) の上限で止まる)。
 * 余った幅は justify-center が grid ごと中央に寄せて左右の外へ落とす。本文
 * トラックを 1fr で膨らませないので、読み幅もレールとの間隔も画面幅で動かない。
 *
 * 左のトラックが auto なのは、ナビの中身に幅を合わせるため。ラベルは左寄せ
 * なので、固定幅のトラックに乗せると文字の右側に余白が残り、そのぶん本文との
 * 間隔が右レール側より広く見える。auto なら箱が一番長いラベルに張り付いて、
 * 左右の間隔が揃う (ラベルを足せば左レールの幅もそのぶん動く)。
 *
 * 右だけは 15rem で固定する。目次の有無で本文を動かさないため。トラックは
 * grid-template-columns が常に確保していて、埋まるかどうかとは無関係。箱の幅
 * そのものは toc-sidebar 側の w-fit が中身に追従させる。
 *
 * 本文とレールの間隔は 80px = 両側の px-edge-h (24 + 24) + トラック間の
 * gap-x-block (32)。レールの中身がどこで終わろうと変わらない。
 *
 * レールは fixed ではなく sticky + self-start + h-dvh。fixed だと本文の脇に
 * 置けず left/right を calc で当てることになるが、sticky なら grid の
 * トラックに乗ったまま上端に貼り付く。見た目の挙動は fixed と同じ。
 *
 * 段が増える幅は 2 つ。lg (1024px) で左が縦レールになり、xl (1280px) で右が出る。
 * それ未満では左が横バーに畳まれ、右は出さない。3 段が収まる幅は 1085px 前後
 * (左レール 157 + 32 + 624 + 32 + 240) だが、その幅ちょうどで出すとレールが
 * ウィンドウの端に貼り付くので、左右に 約 98px 残る xl (1280px) まで待つ。
 */
interface Props {
  /** ページ固有のタイトル */
  title?: string
  /** ページ固有の説明 */
  description?: string
  /** 右レールに出す目次。render() が返す headings をそのまま渡す */
  headings?: MarkdownHeading[]
}

const { title, description, headings } = Astro.props
---

<BaseLayout title={title} description={description}>
  <div
    class="lg:gap-x-block grid w-full grid-cols-1 justify-center lg:grid-cols-[auto_minmax(0,39rem)] xl:grid-cols-[auto_minmax(0,39rem)_15rem]"
  >
    <AppSidebar />
    <main class="px-edge-h pt-edge-top pb-block-loose text-base md:pb-24">
      <div class="mx-auto grid w-full max-w-xl grid-cols-1 gap-10">
        <slot />
      </div>
    </main>
    <TocSidebar headings={headings} />
  </div>
</BaseLayout>
