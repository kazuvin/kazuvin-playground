---
import { Button } from '@/components/ui/button'
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from '@/components/ui/card'
import { PageHeader } from '@/components/ui/page-header'
import { Screen } from '@/components/ui/screen'
import { Text } from '@/components/ui/text'
import {
  Timeline,
  TimelineBody,
  TimelineConnector,
  TimelineContent,
  TimelineDot,
  TimelineIndicator,
  TimelineItem,
  TimelineSeparator,
  TimelineTitle,
} from '@/components/ui/timeline'
import { CATALOG_HEADINGS, TOKEN_GROUPS } from '@/features/design-system/catalog'
import { CommandDemo } from '@/features/design-system/command-demo'
import { DialogDemo } from '@/features/design-system/dialog-demo'
import SectionHeading from '@/features/design-system/section-heading.astro'
import { TokenTable } from '@/features/design-system/token-table'
import CommonLayout from '@/layouts/common-layout.astro'

/*
 * デザインシステムのカタログ。
 *
 * トークンの節は src/styles/globals.css の @theme を読んで組み立てる (出典は
 * features/design-system/catalog.ts)。値を書き写していないので、globals.css を
 * 触れば行も見出しも右の目次もそのまま追随する。
 *
 * 見出しは <SectionHeading id="…" /> だけで書く。文言と段は catalog.ts が持っていて、
 * そこに無い id を渡すとビルドが落ちる。
 */
const title = 'Design System'
const description = 'Kotoba Design System — tokens, primitives and the rules behind them'

const PRINCIPLES = [
  {
    heading: 'プライマリの面は黒',
    body: '塗るのは --color-gray-900 で、アクセントではない。1 画面に塗り面は 1 つ。',
  },
  {
    heading: 'アクセントはフォーカスと選択だけ',
    body: 'rgb(60 130 247) を塗り・ステータス・装飾に使わない。ステータスは色ではなく言葉と位置で示す。',
  },
  {
    heading: '文字は 0.875rem (14px) が上限',
    body: '見出しも本文も同じ 14px。階層はサイズではなく太さ・色・余白で作る。上の段は存在しない。',
  },
] as const

const TEXT_ROLES = [
  'title',
  'heading',
  'subheading',
  'body',
  'lead',
  'caption',
  'label',
  'overline',
] as const
---

<CommonLayout title={title} description={description} headings={CATALOG_HEADINGS}>
  <div>
    <PageHeader title={title} description={description} />
    <Text role="caption">
      トークンの節は <code class="ds-code">src/styles/globals.css</code> の
      <code class="ds-code">@theme</code> をビルド時に読んで組み立てている。値をここに書き写して いないので、CSS
      を触ればこのページも同じだけ動く。
    </Text>
  </div>

  <section>
    <SectionHeading id="principles" />
    <ol class="mt-block-tight border-border-hairline divide-border-hairline divide-y border-y">
      {
        PRINCIPLES.map((principle, index) => (
          <li class="py-inset-y gap-block-tight flex items-baseline">
            <span class="text-muted-foreground w-6 shrink-0 text-sm tabular-nums">{index + 1}</span>
            <div class="min-w-0 flex-1">
              <Text role="label" as="span" className="block">
                {principle.heading}
              </Text>
              <Text role="caption" className="mt-gap-tight">
                {principle.body}
              </Text>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="space-y-block">
    <div>
      <SectionHeading id="tokens" />
      <Text role="lead" className="mt-gap">
        {TOKEN_GROUPS.length} 節 / {
          TOKEN_GROUPS.reduce((total, group) => total + group.rows.length, 0)
        } トークン。並びは globals.css の宣言順のままで、節の前置きも CSS 側のコメントを そのまま持ち上げている。
      </Text>
    </div>

    {
      TOKEN_GROUPS.map((group) => (
        <div>
          <SectionHeading id={`token-${group.id}`} />
          <TokenTable group={group} />
        </div>
      ))
    }
  </section>

  <section class="space-y-block">
    <div>
      <SectionHeading id="components" />
      <Text role="lead" className="mt-gap">
        <code class="ds-code">src/components/ui/</code> のプリミティブ。すべて上のトークンだけで 組まれていて、固有の色やサイズを持たない。
      </Text>
    </div>

    <div>
      <SectionHeading id="component-text" />
      <Text role="caption" className="mt-gap">
        8 つの role。上の 5 つは同じ 14px で、違うのは太さと色だけ。
      </Text>
      <ul class="mt-block-tight border-border-hairline divide-border-hairline divide-y border-y">
        {
          TEXT_ROLES.map((role) => (
            <li class="py-inset-y gap-block-tight flex items-baseline">
              <code class="ds-code text-muted-foreground w-28 shrink-0">{role}</code>
              <div class="min-w-0 flex-1">
                <Text role={role}>見出しも本文も 14px — Aa あア 012</Text>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <SectionHeading id="component-page-header" />
      <div class="mt-block-tight border-border-hairline p-inset-x rounded-card border">
        <PageHeader title="Notes" description="書いたものの置き場" className="mb-0" />
      </div>
    </div>

    <div>
      <SectionHeading id="component-button" />
      <Text role="caption" className="mt-gap">
        面の高さ (40 / 52) とタップ領域 (最低 44) は別のトークン。押下は塗りの差し替えで、
        縮小も不透明度も使わない。
      </Text>
      <div class="mt-block-tight gap-gap flex flex-wrap items-center">
        <Button>Primary</Button>
        <Button variant="secondary">Secondary</Button>
        <Button size="large">Primary / large</Button>
        <Button variant="secondary" size="large">Secondary / large</Button>
        <Button disabled>Disabled</Button>
        <Button variant="secondary" disabled>Disabled</Button>
        <Button variant="secondary" selected>Selected</Button>
      </div>
      <div class="mt-block-tight gap-gap flex flex-col">
        <Button fullWidth>fullWidth</Button>
        <Button variant="secondary" fullWidth>fullWidth / secondary</Button>
      </div>
    </div>

    <div>
      <SectionHeading id="component-card" />
      <Card className="mt-block-tight">
        <CardHeader>
          <CardTitle>カードのタイトル</CardTitle>
          <CardDescription
            >説明は 13 / 400。面と地の差は 1px の境界だけで、影は無い。</CardDescription
          >
        </CardHeader>
        <CardContent>
          <Text role="body">
            本文。カードの角は --radius-card (16px) で、コントロールの 12px とは別のトークン。
          </Text>
        </CardContent>
        <CardFooter>
          <Button variant="secondary">アクション</Button>
        </CardFooter>
      </Card>
    </div>

    <div>
      <SectionHeading id="component-dialog" />
      <div class="mt-block-tight">
        <DialogDemo client:visible />
      </div>
    </div>

    <div>
      <SectionHeading id="component-command" />
      <div class="mt-block-tight">
        <CommandDemo client:visible />
      </div>
    </div>

    <div>
      <SectionHeading id="component-timeline" />
      <Timeline className="mt-block-tight">
        {
          ['公開した', '下書きにした', '書きはじめた'].map((label, index) => (
            <TimelineItem>
              <TimelineContent>
                <TimelineSeparator>
                  <TimelineIndicator>
                    <TimelineDot isActive={index === 0} isCompleted={index > 0} />
                  </TimelineIndicator>
                  {index < 2 && <TimelineConnector />}
                </TimelineSeparator>
                <TimelineBody className="pb-block-tight">
                  <TimelineTitle isActive={index === 0}>{label}</TimelineTitle>
                  <Text role="caption" className="mt-gap-tight">
                    2025-11-0{index + 1}
                  </Text>
                </TimelineBody>
              </TimelineContent>
            </TimelineItem>
          ))
        }
      </Timeline>
    </div>

    <div>
      <SectionHeading id="component-screen" />
      <Text role="caption" className="mt-gap">
        端末幅 390px を模した器。画面端の余白 (24 / 32 / 24) を宣言してよい唯一の場所。
      </Text>
      <div class="mt-block-tight">
        <Screen className="border-border-hairline rounded-card min-h-64 border">
          <Text role="overline">Unit 4 · Requests</Text>
          <div class="h-block"></div>
          <Text role="title" lang="ja">お願いできますか</Text>
          <div class="h-gap"></div>
          <Text role="caption">onegai dekimasu ka</Text>
          <div class="min-h-block-loose flex-1"></div>
          <Button size="large" fullWidth>Got it</Button>
        </Screen>
      </div>
    </div>
  </section>

  <section class="space-y-block">
    <div>
      <SectionHeading id="patterns" />
      <Text role="lead" className="mt-gap">
        プリミティブではなく、globals.css が直接持っているふるまい。
      </Text>
    </div>

    <div>
      <SectionHeading id="pattern-focus" />
      <Text role="caption" className="mt-gap">
        アクセントが許されている 2 箇所のうちの 1 つ。2px を 2px 外側に置くので、角丸は
        コントロールの 12px + 2 = --radius-focus (14px)。下の 2 つを Tab で辿ると出る。
      </Text>
      <div class="mt-block-tight gap-gap flex flex-wrap items-center">
        <Button variant="secondary">ボタン</Button>
        <a href="#pattern-focus" class="underline underline-offset-4">リンク</a>
      </div>
    </div>

    <div>
      <SectionHeading id="pattern-prose" />
      <Text role="caption" className="mt-gap">
        MDX の本文に当たるスタイル。見出しの 4 段はサイズを動かさず、太さ・色・直上の余白
        だけで段を作る。
      </Text>
      <article
        class="note-content mt-block-tight border-border-hairline rounded-card p-inset-x border"
      >
        <h1>h1 — 14 / 700</h1>
        <p>
          本文は 14px の行間 1.75。<a href="#pattern-prose">リンク</a>は色を変えず下線の太さで
          示し、<code>インラインコード</code>は面で区別する。
        </p>
        <h2>h2 — 14 / 600</h2>
        <p>段落の間隔は --spacing-block-tight (20px)。</p>
        <h3>h3 — 14 / 600 + 弱い色</h3>
        <ul>
          <li>順不同リスト</li>
          <li>マーカーは muted-foreground</li>
        </ul>
        <h4>h4 — 14 / 500 + 弱い色</h4>
        <ol>
          <li>順序付きリスト</li>
          <li>字下げは --spacing-inset-x (20px)</li>
        </ol>
        <blockquote>引用は左の 2px 罫と字下げで示す。色は subtle-foreground。</blockquote>
        <pre><code>const spacing = 4 // px</code></pre>
        <table>
          <thead>
            <tr><th>役割</th><th>値</th></tr>
          </thead>
          <tbody>
            <tr><td>境界</td><td>1px hairline</td></tr>
            <tr><td>影</td><td>無し</td></tr>
          </tbody>
        </table>
        <hr />
        <p>区切りは 1px のヘアライン。</p>
      </article>
    </div>

    <div>
      <SectionHeading id="pattern-utilities" />
      <Text role="caption" className="mt-gap">
        @layer utilities の 4 つ。animate-* トークンと組み合わせて、登場を少しずらす。
      </Text>
      <div class="mt-block-tight gap-gap flex flex-wrap">
        <div
          class="animation-forwards animate-fade-slide-up bg-muted rounded-card p-inset-x text-sm opacity-0"
        >
          遅延なし
        </div>
        <div
          class="animation-delay-200 animation-forwards animate-fade-slide-up bg-muted rounded-card p-inset-x text-sm opacity-0"
        >
          animation-delay-200
        </div>
        <div
          class="animation-delay-400 animation-forwards animate-fade-slide-up bg-muted rounded-card p-inset-x text-sm opacity-0"
        >
          animation-delay-400
        </div>
        <div
          class="animation-delay-600 animation-forwards animate-fade-slide-up bg-muted rounded-card p-inset-x text-sm opacity-0"
        >
          animation-delay-600
        </div>
      </div>
    </div>
  </section>
</CommonLayout>

<script>
  /*
   * motion 節の再生ボタン。トークンの値そのものを element.style に流し込むので、
   * globals.css の値を変えれば動きも変わる。island を作るほどの状態は無いので、
   * data 属性を拾う素の script で足りる。
   */
  function replayAnimation(target: HTMLElement, value: string): void {
    target.style.animation = 'none'
    // 差し替えを別フレーム扱いにさせないと、同じ animation は再生されない
    target.getBoundingClientRect()
    target.style.animation = value
  }

  function replayEase(target: HTMLElement, value: string, travel: string): void {
    const parked = target.style.transform === `translateX(${travel}px)`
    target.style.transition = 'none'
    target.getBoundingClientRect()
    target.style.transition = `transform 600ms ${value}`
    target.style.transform = parked ? 'translateX(0px)' : `translateX(${travel}px)`
  }

  for (const button of document.querySelectorAll<HTMLElement>('[data-motion-play]')) {
    const target = button.querySelector<HTMLElement>('[data-motion-target]')
    const value = button.dataset.motionValue
    if (target === null || value === undefined) {
      continue
    }
    button.addEventListener('click', () => {
      if (button.dataset.motionKind === 'animation') {
        replayAnimation(target, value)
        return
      }
      replayEase(target, value, button.dataset.motionTravel ?? '0')
    })
  }
</script>

<style>
  /* トークン名やクラス名を地の文に混ぜるための小さな見た目。.note-content の
     インラインコードと同じ作りだが、あちらは記事本文にしか掛からない。 */
  .ds-code {
    font-family: var(--font-mono);
    background-color: var(--color-muted);
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--radius-sm);
    padding: 1px 4px;
  }
</style>
