---
import BaseLayout from "@/layouts/base-layout.astro";
---

<BaseLayout title="404">
  <div class="flex min-h-screen items-center justify-center">
    <div class="text-center">
      <h1 class="mb-block text-6xl font-bold">404</h1>
      <h2 class="mb-gap text-2xl">Page Not Found</h2>
      <p class="text-subtle-foreground mb-block">
        The page you are looking for does not exist.
      </p>
      <a
        href="/"
        class="bg-primary text-primary-foreground hover:bg-primary-pressed rounded-control inline-block px-6 py-3 transition-colors"
      >
        Go back home
      </a>
    </div>
  </div>
</BaseLayout>
