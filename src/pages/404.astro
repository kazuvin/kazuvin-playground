---
import BaseLayout from '@/layouts/base-layout.astro'
---

<BaseLayout title="404">
  <div class="flex min-h-screen items-center justify-center text-base">
    <div class="text-center">
      {/* 数字ひとつを絵として置く。文字組みの外側なので text-mark */}
      <h1 class="mb-block text-mark font-bold">404</h1>
      <h2 class="mb-gap font-semibold">Page Not Found</h2>
      <p class="text-subtle-foreground mb-block">The page you are looking for does not exist.</p>
      <a
        href="/"
        class="bg-primary text-primary-foreground hover:bg-primary-pressed rounded-control inline-block px-6 py-3 transition-colors"
      >
        Go back home
      </a>
    </div>
  </div>
</BaseLayout>
