---
import type { GetStaticPaths } from 'astro'
import { render } from 'astro:content'
import { getPublishedNotes } from '@/features/notes/notes'
import CommonLayout from '@/layouts/common-layout.astro'

export const getStaticPaths = (async () => {
  const notes = await getPublishedNotes()
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }))
}) satisfies GetStaticPaths

const { note } = Astro.props
/* headings は右レールの目次になる。見出しを持たないノートでは空配列が返り、
   レール自体が描かれない (絞り込みは @/lib/nav の selectTocHeadings)。 */
const { Content, headings } = await render(note)
---

<CommonLayout title={note.data.title} description={note.data.description} headings={headings}>
  <article class="note-content">
    <Content />
  </article>
</CommonLayout>
