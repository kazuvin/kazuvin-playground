---
import type { GetStaticPaths } from 'astro'
import { render } from 'astro:content'
import { getPublishedNotes } from '@/features/notes/notes'
import CommonLayout from '@/layouts/common-layout.astro'

export const getStaticPaths = (async () => {
  const notes = await getPublishedNotes()
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }))
}) satisfies GetStaticPaths

const { note } = Astro.props
const { Content } = await render(note)
---

<CommonLayout title={note.data.title} description={note.data.description}>
  <article class="note-content">
    <Content />
  </article>
</CommonLayout>
