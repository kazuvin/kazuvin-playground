/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Next.js の Static Export (next.config.ts の output: "export") は完全な静的サイトを
 * out/ に出力するため、Worker スクリプトは持たず静的アセットのみを配信する構成にしている。
 * https://developers.cloudflare.com/workers/static-assets/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kazuvin",
  "compatibility_date": "2025-03-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  // 独自ドメインと同じ内容が workers.dev 側でも配信されると検索エンジンに重複として
  // 扱われるため、workers.dev のサブドメインは閉じている。
  "workers_dev": false,
  "routes": [{ "pattern": "kazuvin.me", "custom_domain": true }]
}
